# Unreal Engine's output
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/
Plugins/*/Binaries/
Plugins/*/Intermediate/

# Editors and IDEs
.vs/
.vscode/ipch/
.vscode/compile_commands.json
.idea/
*.sln
*.slnx
*.xcodeproj
*.xcworkspace
*.suo
*.user
