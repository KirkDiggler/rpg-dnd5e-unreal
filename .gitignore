*.opendb

# The compiled contract: generated by scripts/fetch-protos.sh, never committed, never edited
Plugins/RpgWire/Source/RpgWire/Private/pb/

# gRPC and protobuf, built by scripts/build-libs.sh with the engine's toolchain; .libs/ is its working tree
/.libs/
Plugins/RpgWire/Source/ThirdParty/

# Licensed content, mounted from rpg-game-assets by scripts/mount-content.sh (a link or a copy)
Plugins/RpgGameAssets

# Evidence frames: licensed models may be in them; they stay local
evidence/

# Scratch
.superpowers/
__pycache__/
*.pyc
