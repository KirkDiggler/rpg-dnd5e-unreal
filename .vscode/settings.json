{
  "C_Cpp.default.compileCommands": "${workspaceFolder}/.vscode/compile_commands.json",
  "C_Cpp.default.cppStandard": "c++20",
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/.vscode",
    "--background-index",
    "-j=8",
    "--completion-style=detailed",
    "--header-insertion=never"
  ],
  "files.associations": {
    "*.uproject": "json",
    "*.uplugin": "json",
    "*.ini": "ini",
    "*.Build.cs": "csharp",
    "*.Target.cs": "csharp"
  },
  "files.exclude": {
    "**/Binaries": true,
    "**/DerivedDataCache": true,
    "**/Intermediate": true,
    "**/Plugins/RpgWire/Source/ThirdParty": true,
    "**/Private/pb": true,
    "**/Plugins/RpgGameAssets": true,
    "**/.git": true
  },
  "search.exclude": {
    "**/Binaries": true,
    "**/DerivedDataCache": true,
    "**/Intermediate": true,
    "**/Plugins/RpgWire/Source/ThirdParty": true,
    "**/Private/pb": true,
    "**/Plugins/RpgGameAssets": true,
    "**/Saved": true,
    "**/.vscode/ipch": true
  },
  "files.watcherExclude": {
    "**/Binaries": true,
    "**/DerivedDataCache": true,
    "**/Intermediate": true,
    "**/Plugins/RpgWire/Source/ThirdParty": true,
    "**/Private/pb": true,
    "**/Plugins/RpgGameAssets": true,
    "**/Saved": true
  },
  "task.allowAutomaticTasks": "on"
}
