{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to the running editor",
      "type": "cppdbg",
      "request": "attach",
      "processId": "${command:pickProcess}",
      "program": "${env:UE_ROOT}/Engine/Binaries/Linux/UnrealEditor",
      "MIMode": "gdb",
      "cwd": "${workspaceFolder}",
      "setupCommands": [
        {
          "description": "Enable pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Launch the tests under the debugger",
      "type": "cppdbg",
      "request": "launch",
      "program": "${env:UE_ROOT}/Engine/Binaries/Linux/UnrealEditor-Cmd",
      "args": [
        "${workspaceFolder}/RpgDnd5eUnreal.uproject",
        "-ExecCmds=Automation RunTests RpgClient",
        "-TestExit=Automation Test Queue Empty",
        "-nullrhi",
        "-unattended",
        "-NoSound",
        "-stdout",
        "-FullStdOutLogOutput"
      ],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Attach to the running editor (CodeLLDB)",
      "type": "lldb",
      "request": "attach",
      "pid": "${command:pickProcess}",
      "program": "${env:UE_ROOT}/Engine/Binaries/Linux/UnrealEditor"
    }
  ]
}
